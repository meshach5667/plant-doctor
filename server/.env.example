# Plant Doctor API Environment Variables
# Copy this file to .env and update the values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Plant Doctor API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development  # development, staging, production

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=4  # Number of worker processes (for production)

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default for development)
DATABASE_URL="sqlite:///./plant_doctor.db"

# PostgreSQL (recommended for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/plant_doctor"

# =============================================================================
# JWT AUTHENTICATION (IMPORTANT: Change these in production!)
# =============================================================================
# Generate a secure secret key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="your-super-secret-key-change-me-in-production-minimum-32-chars"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30  # 30 minutes
REFRESH_TOKEN_EXPIRE_DAYS=7    # 7 days

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Comma-separated list of allowed origins (use specific origins in production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# MODEL PATHS
# =============================================================================
MODEL_PATH=model/plantDoctor.h5
TFLITE_MODEL_PATH=model/plantDoctor.tflite
MAX_IMAGE_SIZE_MB=10
