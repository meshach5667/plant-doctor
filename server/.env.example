# Plant Doctor API Environment Variables

# Application
APP_NAME="Plant Doctor API"
APP_VERSION="1.0.0"
DEBUG=true

# Database
DATABASE_URL="sqlite:///./plant_doctor.db"

# JWT Secret (CHANGE THIS IN PRODUCTION!)
SECRET_KEY="your-super-secret-key-change-me-in-production"

# Model paths (relative to server directory)
MODEL_PATH="model/plantDoctor.h5"
TFLITE_MODEL_PATH="model/plantDoctor.tflite"
